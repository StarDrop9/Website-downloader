#!/usr/bin/env node
'use strict';

var app = require('../app');
var http = require('http');
var originPolicy = require('../security/origin-policy');
var listenPolicy = require('../security/listen-policy');

var port = normalizePort(process.env.PORT || '3000');
var host;
try {
  host = listenPolicy.validateListen(process.env.HOST, process.env.WEBSITE_DOWNLOADER_ACCESS_TOKEN);
} catch (err) {
  console.error(err.message);
  process.exit(1);
}
app.set('port', port);

var server = http.createServer(app);
var io = require('socket.io')(server, {
  serveClient: true,
  maxHttpBufferSize: 32 * 1024,
  pingTimeout: 20000,
  pingInterval: 25000,
  allowRequest: function (req, callback) {
    var allowed = originPolicy.isAllowedOrigin(
      req && req.headers && req.headers.origin,
      req && req.headers && req.headers.host,
      process.env.WEBSITE_DOWNLOADER_ALLOWED_ORIGIN
    );
    callback(allowed ? null : 'Origin not allowed', allowed);
  }
});

require('../socket/socket')(io);

server.listen(port, host, onListening);
server.on('error', onError);

function normalizePort(val) {
  var parsed = parseInt(val, 10);
  if (isNaN(parsed)) return val;
  if (parsed >= 0) return parsed;
  return false;
}

function onError(error) {
  if (error.syscall !== 'listen') throw error;

  var bind = host + ':' + port;
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

function onListening() {
  var address = server.address();
  var bind = typeof address === 'string' ? 'pipe ' + address : address.address + ':' + address.port;
  console.log('Website Downloader listening on ' + bind);
}
