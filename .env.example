# Safe default: listen only on this machine.
# Set HOST=0.0.0.0 for a container/server deployment; doing so requires an access token.
HOST=127.0.0.1
PORT=3000

# Optional on loopback, required for any non-loopback bind.
# Generate a long random value; never commit the real token.
WEBSITE_DOWNLOADER_ACCESS_TOKEN=

# If a reverse proxy changes the Host header, set the browser-facing origin.
# Example: https://downloads.example.com
WEBSITE_DOWNLOADER_ALLOWED_ORIGIN=

# Resource controls
DOWNLOAD_QUOTA=100m
DOWNLOAD_TIMEOUT_MS=300000
MAX_CONCURRENT_DOWNLOADS=2
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_DOWNLOADS=5
DOWNLOAD_LINK_TTL_MS=600000

# Keep false unless you explicitly need public websites on non-80/443 ports.
ALLOW_NONSTANDARD_PORTS=false
